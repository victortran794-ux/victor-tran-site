{
  "name": "victor-tran-site-build-tools",
  "private": true,
  "scripts": {
    "build:pikapp-demo": "tailwindcss -c pikappapp/tailwind.config.cjs -i pikappapp/demo-source.css -o pikappapp/demo.bundle.css --minify && esbuild pikappapp/demo-source.jsx --bundle --minify --format=esm --target=es2022 --outfile=pikappapp/demo.bundle.js",
    "check:pikapp-demo": "node scripts/check-pikapp-demo-build.mjs",
    "check:pikapp-page": "node scripts/check-pikapp-page-integration.mjs",
    "check:pikapp-page-browser": "node scripts/check-pikapp-page-browser.mjs",
    "check:ibmcloud-browser": "node scripts/check-ibmcloud-browser.mjs",
    "check:ibm-patterns": "node scripts/check-ibm-patterns-integration.mjs",
    "check:ibm-patterns-browser": "node scripts/check-ibm-patterns-browser.mjs",
    "check:wxo-document-processing": "node scripts/check-wxo-document-processing-integration.mjs",
    "check:wxo-document-processing-browser": "node scripts/check-wxo-document-processing-browser.mjs",
    "check:route02-homepage": "node scripts/check-route02-homepage-integration.mjs",
    "check:home-lens-portal-browser": "node scripts/check-home-lens-portal-browser.mjs",
    "check:about-browser": "node scripts/test-about-browser-process.mjs && node scripts/check-about-browser.mjs",
    "check:artifact-containment": "node scripts/check-production-artifact-containment.mjs",
    "check:pci-claims-protection": "node scripts/check-pci-claims-protection.mjs",
    "check:pci-browser": "node scripts/check-pci-browser.mjs",
    "check:sal-vico2": "python3 scripts/check-sal-vico2.py",
    "check:sal-browser": "node scripts/check-sal-browser.mjs",
    "verify:pikapp-demo": "npm run build:pikapp-demo && git diff --exit-code -- pikappapp/demo.bundle.css pikappapp/demo.bundle.js && npm run check:pikapp-demo",
    "test:content-export-policy": "node scripts/test-html-to-md.mjs",
    "check:content-export-policy": "node scripts/check-protected-content-exports.mjs",
    "generate:private-content": "node scripts/html-to-md.mjs --mode private",
    "generate:site-shell": "node scripts/generate-site-shell.mjs",
    "test:site-shell": "node scripts/test-site-shell.mjs",
    "check:site-shell": "node scripts/check-shared-shell.mjs",
    "check:site-shell-browser": "node scripts/check-shared-shell-browser.mjs",
    "build:visual-archives": "python3 scripts/build-visual-archives-integration.py all",
    "check:visual-archives": "node scripts/check-visual-archives-integration.mjs all",
    "check:visual-archives-browser": "node scripts/check-visual-archives-browser.mjs all"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "framer-motion": "11.11.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17"
  }
}
