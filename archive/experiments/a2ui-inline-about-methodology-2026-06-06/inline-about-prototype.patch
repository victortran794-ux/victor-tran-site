+      updateComponents: [
+        {
+          id: 'status',
+          component: 'StatusCard',
+          label: 'Method',
+          title: 'The agent describes intent. The site owns the interface.',
+          body: 'That is the useful A2UI lesson for this portfolio: structured payloads, trusted components, renderer-controlled styling, and inspectable state.'
+        },
+        {
+          id: 'evidence',
+          component: 'EvidenceCard',
+          label: 'Catalog',
+          items: ['StatusCard', 'RecommendationCard', 'EvidenceCard', 'PlaylistNote', 'GameNote', 'DnaPanel']
+        }
+      ]
+    }
+  };
+
+  function escapeHTML(value) {
+    return String(value).replace(/[&<>"']/g, (char) => ({
+      '&': '&amp;',
+      '<': '&lt;',
+      '>': '&gt;',
+      '"': '&quot;',
+      "'": '&#39;'
+    }[char]));
+  }
+
+  function renderComponent(component) {
+    const type = component.component || 'StatusCard';
+    const modifier = type === 'RecommendationCard' ? ' about-agent-card--recommendation' : '';
+    const body = component.body ? `<p>${escapeHTML(component.body)}</p>` : '';
+    const items = Array.isArray(component.items) && component.items.length
+      ? `<ul>${component.items.map(item => `<li>${escapeHTML(item)}</li>`).join('')}</ul>`
+      : '';
+    const link = component.href
+      ? `<a class="about-agent-card-link" href="${escapeHTML(component.href)}">${escapeHTML(component.cta || 'Open')}</a>`
+      : '';
+
+    return `
+      <article class="about-agent-card${modifier}">
+        <span class="about-agent-card-label">${escapeHTML(component.label || type)}</span>
+        <h3>${escapeHTML(component.title || 'Untitled response')}</h3>
+        ${body}
+        ${items}
+        ${link}
+        <span class="about-agent-card-meta">${escapeHTML(type)}</span>
+      </article>
+    `;
+  }
+
+  function renderPrompt(key) {
+    const payload = prompts[key] || prompts.first;
+    surface.innerHTML = payload.updateComponents.map(renderComponent).join('');
+    dnaCode.textContent = JSON.stringify(payload, null, 2);
+    if (!dna.hidden) {
+      inspectBtn.setAttribute('aria-expanded', 'true');
+    }
+  }
+
+  chips.forEach(chip => {
+    chip.addEventListener('click', () => {
+      chips.forEach(item => item.classList.remove('is-active'));
+      chip.classList.add('is-active');
+      renderPrompt(chip.dataset.a2uiPrompt);
+    });
+  });
+
+  inspectBtn.addEventListener('click', () => {
+    const isHidden = dna.hidden;
+    dna.hidden = !isHidden;
+    inspectBtn.setAttribute('aria-expanded', String(isHidden));
+    inspectBtn.textContent = isHidden ? 'Hide payload' : 'Inspect payload';
+  });
+
+  renderPrompt('first');
+})();
