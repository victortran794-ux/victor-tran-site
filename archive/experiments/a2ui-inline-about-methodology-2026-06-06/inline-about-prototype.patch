 }
 
+/* Inline A2UI methodology prototype */
+.about-studio-agent {
+  grid-column: 1 / -1;
+  display: grid;
+  grid-template-columns: minmax(220px, 0.55fr) minmax(0, 1fr);
+  gap: var(--space-8);
+  padding: var(--space-8);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  background:
+    radial-gradient(circle at top left, rgba(223, 82, 130, 0.10), transparent 34%),
+    var(--bg-2);
+}
+
+.about-studio-agent-copy {
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  gap: var(--space-6);
+}
+
+.about-agent-note {
+  font-family: 'Source Code Pro', monospace;
+  font-size: var(--text-caption);
+  line-height: 1.6;
+  color: var(--text-2);
+  max-width: 44ch;
+}
+
+.about-agent-shell {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-5);
+  min-width: 0;
+}
+
+.about-agent-prompts {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+}
+
+.about-agent-chip,
+.about-agent-inspect,
+.about-agent-card-link {
+  border: 1px solid var(--border);
+  border-radius: var(--radius-pill);
+  background: var(--bg);
+  color: var(--text);
+  font-family: 'Barlow', sans-serif;
+  font-size: var(--text-label);
+  font-weight: 600;
+  line-height: 1.2;
+  padding: var(--space-2) var(--space-4);
+  cursor: pointer;
+  transition: border-color var(--duration-fast), color var(--duration-fast), transform var(--duration-fast), background var(--duration-fast);
+}
+
+.about-agent-chip:hover,
+.about-agent-inspect:hover,
+.about-agent-card-link:hover {
+  border-color: var(--blue);
+  color: var(--blue);
+  transform: translateY(-1px);
+}
+
+.about-agent-chip.is-active {
+  background: var(--text);
+  border-color: var(--text);
+  color: var(--bg);
+}
+
+.about-agent-surface {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-4);
+}
+
+.about-agent-card {
+  min-width: 0;
+  padding: var(--space-5);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  background: var(--bg);
+}
+
+.about-agent-card--recommendation {
+  background: var(--orange);
+  border-color: var(--orange);
+  color: #ffffff;
+}
+
+.about-agent-card--recommendation .about-agent-card-label,
+.about-agent-card--recommendation p,
+.about-agent-card--recommendation .about-agent-card-meta {
+  color: rgba(255, 255, 255, 0.84);
+}
+
+.about-agent-card--recommendation h3 { color: #ffffff; }
+
+.about-agent-card--recommendation .about-agent-card-link {
+  background: rgba(255, 255, 255, 0.14);
+  border-color: rgba(255, 255, 255, 0.5);
+  color: #ffffff;
+}
+
+.about-agent-card-label {
+  display: block;
+  font-family: 'Source Code Pro', monospace;
+  font-size: var(--text-caption);
+  text-transform: uppercase;
+  letter-spacing: 0.12em;
+  color: var(--text-2);
+  margin-bottom: var(--space-3);
+}
+
+.about-agent-card h3 {
+  font-family: 'DM Serif Display', serif;
+  font-size: var(--text-subheading);
+  font-weight: 400;
+  line-height: 1.12;
+  color: var(--text);
+  margin-bottom: var(--space-3);
+}
+
+.about-agent-card p,
+.about-agent-card li {
+  font-size: var(--text-body);
+  line-height: 1.65;
+  color: var(--text-2);
+}
+
+.about-agent-card ul {
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+  margin: 0;
+}
+
+.about-agent-card li::before {
+  content: '';
+  display: inline-block;
+  width: 6px;
+  height: 6px;
+  margin-right: var(--space-2);
+  border-radius: 1px;
+  background: var(--pink);
+  transform: translateY(-1px);
+}
+
+.about-agent-card-meta {
+  display: block;
+  margin-top: var(--space-4);
+  font-family: 'Source Code Pro', monospace;
+  font-size: var(--text-caption);
+  color: var(--text-2);
+}
+
+.about-agent-card-link {
+  display: inline-flex;
+  align-items: center;
+  width: fit-content;
+  margin-top: var(--space-4);
+  text-decoration: none;
+}
+
+.about-agent-actions {
+  display: flex;
+  justify-content: flex-end;
+}
+
+.about-agent-dna {
+  max-height: 340px;
+  overflow: auto;
+  padding: var(--space-5);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  background: var(--text);
+  color: var(--bg);
+  font-family: 'Source Code Pro', monospace;
+  font-size: var(--text-caption);
+  line-height: 1.7;
+  white-space: pre-wrap;
+}
+
+.about-agent-dna[hidden] { display: none; }
+
+@media (max-width: 980px) {
+  .about-studio-agent {
+    grid-template-columns: 1fr;
+  }
+
+  .about-agent-surface {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 640px) {
+  .about-studio-agent {
+    padding: var(--space-6);
+  }
+
+  .about-agent-prompts {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .about-agent-chip,
+  .about-agent-inspect,
+  .about-agent-card-link {
+    width: 100%;
+    justify-content: center;
+    text-align: center;
+  }
+}
+
 
